[
  {
    "name": "move_token",
    "description": "Move a token to a new grid position on its scene.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tokenId": { "type": "string" },
        "to": {
          "type": "object",
          "properties": {
            "x": { "type": "integer" },
            "y": { "type": "integer" }
          },
          "required": ["x", "y"]
        },
        "reason": { "type": "string" }
      },
      "required": ["tokenId", "to"]
    }
  },
  {
    "name": "create_scene",
    "description": "Create a new scene with a grid.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "sceneId": { "type": "string" },
        "name": { "type": "string" },
        "gridWidth": { "type": "integer" },
        "gridHeight": { "type": "integer" }
      },
      "required": ["sceneId", "name", "gridWidth", "gridHeight"]
    }
  },
  {
    "name": "add_actor",
    "description": "Add an actor to the campaign.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "object",
          "properties": {
            "actorId": { "type": "string" },
            "name": {
              "type": "string",
              "description": "Optional display label for the actor."
            },
            "moduleId": {
              "type": "string",
              "description": "Optional; omit unless a rule module instructs otherwise — moduleData is opaque."
            },
            "attributes": {
              "type": "object",
              "additionalProperties": { "type": "integer" },
              "description": "Optional; omit unless a rule module instructs otherwise — moduleData is opaque."
            },
            "resources": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "current": { "type": "integer" },
                  "max": { "type": "integer" }
                },
                "required": ["current", "max"]
              },
              "description": "Optional; omit unless a rule module instructs otherwise — moduleData is opaque."
            },
            "moduleData": {
              "type": "object",
              "description": "Optional; omit unless a rule module instructs otherwise — moduleData is opaque."
            },
            "controllerId": {
              "type": "string",
              "description": "Omit or empty = DM/agent-controlled; set a participant id to hand control to a player."
            }
          },
          "required": ["actorId"]
        }
      },
      "required": ["actor"]
    }
  },
  {
    "name": "place_token",
    "description": "Place an actor's token on a scene's grid.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tokenId": { "type": "string" },
        "sceneId": { "type": "string" },
        "actorId": { "type": "string" },
        "position": {
          "type": "object",
          "properties": {
            "x": { "type": "integer" },
            "y": { "type": "integer" }
          },
          "required": ["x", "y"]
        }
      },
      "required": ["tokenId", "sceneId", "actorId", "position"]
    }
  },
  {
    "name": "start_session",
    "description": "Start a new play session.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"]
    }
  },
  {
    "name": "end_session",
    "description": "End the current play session.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": []
    }
  },
  {
    "name": "retract_events",
    "description": "Retract a range of events from the record with a stated reason.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "fromSequence": { "type": "integer" },
        "toSequence": { "type": "integer" },
        "reason": { "type": "string" }
      },
      "required": ["fromSequence", "toSequence", "reason"]
    }
  },
  {
    "name": "use_ability",
    "description": "Use one of the loaded ruleset's abilities as an actor against explicit targets.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "actorId": { "type": "string" },
        "abilityId": { "type": "string" },
        "targetIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["actorId", "abilityId", "targetIds"]
    }
  },
  {
    "name": "remove_condition",
    "description": "Remove a named condition from an actor (DM-ended durations).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "actorId": { "type": "string" },
        "conditionId": { "type": "string" }
      },
      "required": ["actorId", "conditionId"]
    }
  },
  {
    "name": "add_narration",
    "description": "Add a story entry to the table's shared narrative — narration, in-character speech (set `as`), or table talk; optionally anchored to the event sequences it narrates.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "as": { "type": "string" },
        "anchorFromSeq": { "type": "integer" },
        "anchorToSeq": { "type": "integer" }
      },
      "required": ["text", "as", "anchorFromSeq", "anchorToSeq"]
    }
  },
  {
    "name": "upsert_note",
    "description": "Create or replace a keyed world note (locations, NPCs, quest state) — the campaign's durable memory.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "title": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["key", "title", "text"]
    }
  },
  {
    "name": "delete_note",
    "description": "Delete a world note by key.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "key": { "type": "string" }
      },
      "required": ["key"]
    }
  }
]
