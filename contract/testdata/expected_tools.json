[
  {
    "name": "move_token",
    "description": "Move a token to a new grid position on its scene.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tokenId": { "type": "string" },
        "to": {
          "type": "object",
          "properties": {
            "x": { "type": "integer" },
            "y": { "type": "integer" }
          },
          "required": ["x", "y"]
        },
        "reason": { "type": "string" }
      },
      "required": ["tokenId", "to"]
    }
  }
]
