{
  "id": "proving-grounds",
  "name": "Proving Grounds",
  "format_version": "3",
  "properties": [
    {
      "key": "vim",
      "type": "number",
      "name": "Vim",
      "description": "The fixture's vim."
    },
    {
      "key": "vigor",
      "type": "number",
      "name": "Vigor",
      "description": "The fixture's vigor."
    },
    {
      "key": "brace",
      "type": "number",
      "name": "Brace",
      "description": "The fixture's brace."
    },
    {
      "key": "focus",
      "type": "resource",
      "name": "Focus",
      "description": "The fixture's focus.",
      "default_max_expr": "10 + @vim",
      "thresholds": [
        {
          "when": "#focus",
          "apply_condition": "winded",
          "remove_when_false": true
        }
      ]
    }
  ]
}
