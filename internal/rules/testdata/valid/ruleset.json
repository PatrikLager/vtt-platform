{
  "id": "test-ruleset",
  "name": "Test Ruleset",
  "format_version": "3",
  "properties": [
    {
      "key": "pool_a",
      "type": "resource",
      "name": "Pool a",
      "description": "The fixture's pool a.",
      "default_max_expr": "10 + @brawn",
      "thresholds": [
        {
          "when": "#pool_a",
          "apply_condition": "guarded",
          "remove_when_false": true
        }
      ]
    },
    {
      "key": "brawn",
      "type": "number",
      "name": "Brawn",
      "description": "The fixture's brawn."
    },
    {
      "key": "grit",
      "type": "number",
      "name": "Grit",
      "description": "The fixture's grit."
    },
    {
      "key": "guard",
      "type": "number",
      "name": "Guard",
      "description": "The fixture's guard."
    }
  ]
}
