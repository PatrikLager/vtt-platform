{
  "id": "minimal-v2",
  "name": "Minimal V2",
  "format_version": "3",
  "properties": [
    {
      "key": "str",
      "type": "number",
      "name": "Str",
      "description": "The fixture's str."
    },
    {
      "key": "def",
      "type": "number",
      "name": "Def",
      "description": "The fixture's def."
    },
    {
      "key": "pool",
      "type": "resource",
      "name": "Pool",
      "description": "The fixture's pool.",
      "default_max_expr": "5",
      "thresholds": [
        {
          "when": "#pool",
          "apply_condition": "marked",
          "remove_when_false": true
        }
      ]
    }
  ]
}
