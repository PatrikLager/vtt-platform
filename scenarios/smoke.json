{
  "name": "smoke",
  "participants": [
    {"name": "dm", "role": "dm"}
  ],
  "steps": [
    {"by": "dm", "command": {"startSession": {"name": "Smoke Session"}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"createScene": {"sceneId": "scn-smoke", "name": "Smoke Scene", "gridWidth": 5, "gridHeight": 5, "tiles": {
        "0,0": {"kind": "floor"}, "1,0": {"kind": "floor"}, "2,0": {"kind": "floor"}, "3,0": {"kind": "floor"}, "4,0": {"kind": "floor"},
        "0,1": {"kind": "floor"}, "1,1": {"kind": "floor"}, "2,1": {"kind": "floor"}, "3,1": {"kind": "floor"}, "4,1": {"kind": "floor"},
        "0,2": {"kind": "floor"}, "1,2": {"kind": "floor"}, "2,2": {"kind": "floor"}, "3,2": {"kind": "floor"}, "4,2": {"kind": "floor"},
        "0,3": {"kind": "floor"}, "1,3": {"kind": "floor"}, "2,3": {"kind": "floor"}, "3,3": {"kind": "floor"}, "4,3": {"kind": "floor"},
        "0,4": {"kind": "floor"}, "1,4": {"kind": "floor"}, "2,4": {"kind": "floor"}, "3,4": {"kind": "floor"}, "4,4": {"kind": "floor"}
      }}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"addActor": {"actor": {"actorId": "act-smoke", "name": "Smoke Actor", "kind": "ACTOR_KIND_NON_PARTY"}}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"placeToken": {"tokenId": "tok-smoke", "sceneId": "scn-smoke", "actorId": "act-smoke", "position": {"x": 0, "y": 0}}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"moveToken": {"tokenId": "tok-smoke", "to": {"x": 1, "y": 1}}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"endSession": {}}, "expect": {"ok": true}}
  ],
  "probes": [
    {"tokenAt": {"tokenId": "tok-smoke", "x": 1, "y": 1}},
    {"sessionCount": {"open": 0, "total": 1}},
    {"actorExists": {"actorId": "act-smoke"}}
  ]
}
