{
  "name": "denials",
  "participants": [
    {"name": "dm", "role": "dm"},
    {"name": "player", "role": "player"},
    {"name": "spectator", "role": "spectator"}
  ],
  "steps": [
    {"by": "dm", "command": {"startSession": {"name": "Denials"}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"createScene": {"sceneId": "scn-deny", "name": "Deny Hall", "gridWidth": 5, "gridHeight": 5, "tiles": {
        "0,0": {"kind": "floor"}, "1,0": {"kind": "floor"}, "2,0": {"kind": "floor"}, "3,0": {"kind": "floor"}, "4,0": {"kind": "floor"},
        "0,1": {"kind": "floor"}, "1,1": {"kind": "floor"}, "2,1": {"kind": "floor"}, "3,1": {"kind": "floor"}, "4,1": {"kind": "floor"},
        "0,2": {"kind": "floor"}, "1,2": {"kind": "floor"}, "2,2": {"kind": "floor"}, "3,2": {"kind": "floor"}, "4,2": {"kind": "floor"},
        "0,3": {"kind": "floor"}, "1,3": {"kind": "floor"}, "2,3": {"kind": "floor"}, "3,3": {"kind": "floor"}, "4,3": {"kind": "floor"},
        "0,4": {"kind": "floor"}, "1,4": {"kind": "floor"}, "2,4": {"kind": "floor"}, "3,4": {"kind": "floor"}, "4,4": {"kind": "floor"}
      }}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"addActor": {"actor": {"actorId": "act-npc", "name": "NPC", "kind": "ACTOR_KIND_NON_PARTY"}}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"placeToken": {"tokenId": "tok-npc", "sceneId": "scn-deny", "actorId": "act-npc", "position": {"x": 0, "y": 0}}}, "expect": {"ok": true}},

    {"by": "player", "command": {"createScene": {"sceneId": "scn-player-deny", "name": "nope", "gridWidth": 1, "gridHeight": 1, "tiles": {
        "0,0": {"kind": "floor"}
      }}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "player", "command": {"addActor": {"actor": {"actorId": "act-player-deny", "name": "nope", "kind": "ACTOR_KIND_NON_PARTY"}}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "player", "command": {"placeToken": {"tokenId": "tok-player-deny", "sceneId": "scn-deny", "actorId": "act-npc", "position": {"x": 1, "y": 1}}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "player", "command": {"startSession": {"name": "nope"}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "player", "command": {"endSession": {}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "player", "command": {"moveToken": {"tokenId": "tok-npc", "to": {"x": 2, "y": 2}}}, "expect": {"deniedContaining": "not authorized"}},

    {"by": "dm", "command": {"grantActorControl": {"actorId": "act-npc", "participantId": "{{id:player}}"}}, "expect": {"deniedContaining": "must say what the actor IS"}},
    {"by": "dm", "command": {"addActor": {"actor": {"actorId": "act-seeded", "name": "Seeded", "kind": "ACTOR_KIND_NON_PARTY", "controllerId": "{{id:player}}"}}}, "expect": {"deniedContaining": "control is conferred by grant_actor_control"}},

    {"by": "spectator", "command": {"moveToken": {"tokenId": "tok-npc", "to": {"x": 3, "y": 3}}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "spectator", "command": {"createScene": {"sceneId": "scn-spectator-deny", "name": "nope", "gridWidth": 1, "gridHeight": 1, "tiles": {
        "0,0": {"kind": "floor"}
      }}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "spectator", "command": {"addActor": {"actor": {"actorId": "act-spectator-deny", "name": "nope", "kind": "ACTOR_KIND_NON_PARTY"}}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "spectator", "command": {"placeToken": {"tokenId": "tok-spectator-deny", "sceneId": "scn-deny", "actorId": "act-npc", "position": {"x": 4, "y": 4}}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "spectator", "command": {"startSession": {"name": "nope"}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "spectator", "command": {"endSession": {}}, "expect": {"deniedContaining": "not authorized"}}
  ],
  "probes": [
    {"tokenAt": {"tokenId": "tok-npc", "x": 0, "y": 0}},
    {"sessionCount": {"open": 1, "total": 1}},
    {"actorExists": {"actorId": "act-npc"}}
  ]
}
