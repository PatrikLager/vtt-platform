{
  "name": "denials",
  "maps": "scenarios/maps",
  "participants": [
    {"name": "dm", "role": "dm"},
    {"name": "Anna", "role": "spectator"},
    {"name": "Kalle", "role": "spectator"}
  ],
  "steps": [
    {"by": "dm", "command": {"startSession": {"name": "Denials"}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"loadMap": {"mapId": "scn-deny"}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"addActor": {"actor": {"actorId": "act-npc", "name": "NPC", "kind": "ACTOR_KIND_NON_PARTY"}}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"placeToken": {"tokenId": "tok-npc", "sceneId": "scn-deny", "actorId": "act-npc", "position": {"x": 0, "y": 0}}}, "expect": {"ok": true}},

    {"by": "Anna", "command": {"loadMap": {"mapId": "scn-annex"}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "Anna", "command": {"addActor": {"actor": {"actorId": "act-player-deny", "name": "nope", "kind": "ACTOR_KIND_NON_PARTY"}}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "Anna", "command": {"placeToken": {"tokenId": "tok-player-deny", "sceneId": "scn-deny", "actorId": "act-npc", "position": {"x": 1, "y": 1}}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "Anna", "command": {"startSession": {"name": "nope"}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "Anna", "command": {"endSession": {}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "Anna", "command": {"moveToken": {"tokenId": "tok-npc", "to": {"x": 2, "y": 2}}}, "expect": {"deniedContaining": "not authorized"}},

    {"by": "dm", "command": {"grantActorControl": {"actorId": "act-npc", "participantId": "{{id:Anna}}"}}, "expect": {"deniedContaining": "must say what the actor IS"}},
    {"by": "dm", "command": {"addActor": {"actor": {"actorId": "act-seeded", "name": "Seeded", "kind": "ACTOR_KIND_NON_PARTY", "controllerId": "{{id:Anna}}"}}}, "expect": {"deniedContaining": "control is conferred by grant_actor_control"}},

    {"by": "Kalle", "command": {"moveToken": {"tokenId": "tok-npc", "to": {"x": 3, "y": 3}}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "Kalle", "command": {"loadMap": {"mapId": "scn-annex"}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "Kalle", "command": {"addActor": {"actor": {"actorId": "act-spectator-deny", "name": "nope", "kind": "ACTOR_KIND_NON_PARTY"}}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "Kalle", "command": {"placeToken": {"tokenId": "tok-spectator-deny", "sceneId": "scn-deny", "actorId": "act-npc", "position": {"x": 4, "y": 4}}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "Kalle", "command": {"startSession": {"name": "nope"}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "Kalle", "command": {"endSession": {}}, "expect": {"deniedContaining": "not authorized"}}
  ],
  "probes": [
    {"tokenAt": {"tokenId": "tok-npc", "x": 0, "y": 0}},
    {"sessionCount": {"open": 1, "total": 1}},
    {"actorExists": {"actorId": "act-npc"}}
  ]
}
