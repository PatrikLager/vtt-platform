{
  "name": "three-role-exit",
  "maps": "scenarios/maps",
  "participants": [
    {"name": "dm", "role": "dm"},
    {"name": "Anna", "role": "spectator"},
    {"name": "agent", "role": "agent"},
    {"name": "Kalle", "role": "spectator"}
  ],
  "steps": [
    {"by": "dm", "command": {"startSession": {"name": "Exit Scenario"}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"loadMap": {"mapId": "scn-exit"}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"addActor": {"actor": {"actorId": "act-ursus", "name": "Ursus", "kind": "ACTOR_KIND_NON_PARTY"}}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"addActor": {"actor": {"actorId": "act-lera", "name": "Lera", "kind": "ACTOR_KIND_PARTY_MEMBER"}}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"grantActorControl": {"actorId": "act-lera", "participantId": "{{id:Anna}}", "kind": "ACTOR_KIND_PARTY_MEMBER"}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"placeToken": {"tokenId": "tok-ursus", "sceneId": "scn-exit", "actorId": "act-ursus", "position": {"x": 0, "y": 0}}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"placeToken": {"tokenId": "tok-lera", "sceneId": "scn-exit", "actorId": "act-lera", "position": {"x": 1, "y": 1}}}, "expect": {"ok": true}},

    {"by": "Anna", "command": {"moveToken": {"tokenId": "tok-lera", "to": {"x": 2, "y": 2}}}, "expect": {"ok": true}},
    {"by": "Anna", "command": {"moveToken": {"tokenId": "tok-ursus", "to": {"x": 9, "y": 9}}}, "expect": {"deniedContaining": "not authorized"}},

    {"by": "agent", "command": {"moveToken": {"tokenId": "tok-ursus", "to": {"x": 5, "y": 5}}}, "expect": {"ok": true}},

    {"by": "Kalle", "command": {"startSession": {"name": "hijack"}}, "expect": {"deniedContaining": "not authorized"}},

    {"by": "dm", "command": {"endSession": {}}, "expect": {"ok": true}},

    {"by": "Anna", "reconnect": {"afterSequence": 0}},
    {"by": "Kalle", "reconnect": {"afterSequence": 0}}
  ],
  "probes": [
    {"tokenAt": {"tokenId": "tok-lera", "x": 2, "y": 2}},
    {"tokenAt": {"tokenId": "tok-ursus", "x": 5, "y": 5}},
    {"sessionCount": {"open": 0, "total": 1}},
    {"actorExists": {"actorId": "act-ursus"}},
    {"actorExists": {"actorId": "act-lera"}}
  ]
}
