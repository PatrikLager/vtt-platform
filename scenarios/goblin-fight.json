{
  "name": "goblin-fight",
  "ruleset": "dnd45e-minimal",
  "participants": [
    {"name": "dm", "role": "dm"},
    {"name": "fighter", "role": "player"},
    {"name": "spectator", "role": "spectator"}
  ],
  "steps": [
    {"by": "dm", "command": {"startSession": {"name": "Goblin Fight"}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"createScene": {"sceneId": "scn-goblin-fight", "name": "Forest Trail", "gridWidth": 31, "gridHeight": 3, "tiles": {
        "0,0": {"kind": "floor"}, "1,0": {"kind": "floor"}, "2,0": {"kind": "floor"}, "3,0": {"kind": "floor"}, "4,0": {"kind": "floor"}, "5,0": {"kind": "floor"}, "6,0": {"kind": "floor"}, "7,0": {"kind": "floor"}, "8,0": {"kind": "floor"}, "9,0": {"kind": "floor"}, "10,0": {"kind": "floor"}, "11,0": {"kind": "floor"}, "12,0": {"kind": "floor"}, "13,0": {"kind": "floor"}, "14,0": {"kind": "floor"}, "15,0": {"kind": "floor"}, "16,0": {"kind": "floor"}, "17,0": {"kind": "floor"}, "18,0": {"kind": "floor"}, "19,0": {"kind": "floor"}, "20,0": {"kind": "floor"}, "21,0": {"kind": "floor"}, "22,0": {"kind": "floor"}, "23,0": {"kind": "floor"}, "24,0": {"kind": "floor"}, "25,0": {"kind": "floor"}, "26,0": {"kind": "floor"}, "27,0": {"kind": "floor"}, "28,0": {"kind": "floor"}, "29,0": {"kind": "floor"}, "30,0": {"kind": "floor"},
        "0,1": {"kind": "floor"}, "1,1": {"kind": "floor"}, "2,1": {"kind": "floor"}, "3,1": {"kind": "floor"}, "4,1": {"kind": "floor"}, "5,1": {"kind": "floor"}, "6,1": {"kind": "floor"}, "7,1": {"kind": "floor"}, "8,1": {"kind": "floor"}, "9,1": {"kind": "floor"}, "10,1": {"kind": "floor"}, "11,1": {"kind": "floor"}, "12,1": {"kind": "floor"}, "13,1": {"kind": "floor"}, "14,1": {"kind": "floor"}, "15,1": {"kind": "floor"}, "16,1": {"kind": "floor"}, "17,1": {"kind": "floor"}, "18,1": {"kind": "floor"}, "19,1": {"kind": "floor"}, "20,1": {"kind": "floor"}, "21,1": {"kind": "floor"}, "22,1": {"kind": "floor"}, "23,1": {"kind": "floor"}, "24,1": {"kind": "floor"}, "25,1": {"kind": "floor"}, "26,1": {"kind": "floor"}, "27,1": {"kind": "floor"}, "28,1": {"kind": "floor"}, "29,1": {"kind": "floor"}, "30,1": {"kind": "floor"},
        "0,2": {"kind": "floor"}, "1,2": {"kind": "floor"}, "2,2": {"kind": "floor"}, "3,2": {"kind": "floor"}, "4,2": {"kind": "floor"}, "5,2": {"kind": "floor"}, "6,2": {"kind": "floor"}, "7,2": {"kind": "floor"}, "8,2": {"kind": "floor"}, "9,2": {"kind": "floor"}, "10,2": {"kind": "floor"}, "11,2": {"kind": "floor"}, "12,2": {"kind": "floor"}, "13,2": {"kind": "floor"}, "14,2": {"kind": "floor"}, "15,2": {"kind": "floor"}, "16,2": {"kind": "floor"}, "17,2": {"kind": "floor"}, "18,2": {"kind": "floor"}, "19,2": {"kind": "floor"}, "20,2": {"kind": "floor"}, "21,2": {"kind": "floor"}, "22,2": {"kind": "floor"}, "23,2": {"kind": "floor"}, "24,2": {"kind": "floor"}, "25,2": {"kind": "floor"}, "26,2": {"kind": "floor"}, "27,2": {"kind": "floor"}, "28,2": {"kind": "floor"}, "29,2": {"kind": "floor"}, "30,2": {"kind": "floor"}
      }}}, "expect": {"ok": true}},

    {"by": "dm", "command": {"addActor": {"actor": {
      "actorId": "act-fighter", "name": "Human Fighter", "kind": "ACTOR_KIND_PARTY_MEMBER",
      "attributes": {"str": 4, "dex": 2, "con": 3, "max_hp": 28, "ac": 17, "fort": 15, "ref": 13, "will": 12},
      "resources": {"hp": {"current": 28, "max": 28}, "flurry_uses": {"current": 1, "max": 1}}
    }}}, "expect": {"ok": true}},

    {"by": "dm", "command": {"addActor": {"actor": {
      "actorId": "act-cutter", "name": "Goblin Cutter", "kind": "ACTOR_KIND_NON_PARTY",
      "attributes": {"str": 1, "dex": 3, "con": 1, "max_hp": 8, "ac": 15, "fort": 12, "ref": 14, "will": 11},
      "resources": {"hp": {"current": 8, "max": 8}}
    }}}, "expect": {"ok": true}},

    {"by": "dm", "command": {"addActor": {"actor": {
      "actorId": "act-archer", "name": "Goblin Archer", "kind": "ACTOR_KIND_NON_PARTY",
      "attributes": {"str": 0, "dex": 4, "con": 1, "max_hp": 6, "ac": 14, "fort": 11, "ref": 15, "will": 11},
      "resources": {"hp": {"current": 6, "max": 6}}
    }}}, "expect": {"ok": true}},

    {"by": "dm", "command": {"grantActorControl": {"actorId": "act-fighter", "participantId": "{{id:fighter}}", "kind": "ACTOR_KIND_PARTY_MEMBER"}}, "expect": {"ok": true}},

    {"by": "dm", "command": {"placeToken": {"tokenId": "tok-fighter", "sceneId": "scn-goblin-fight", "actorId": "act-fighter", "position": {"x": 0, "y": 0}}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"placeToken": {"tokenId": "tok-cutter", "sceneId": "scn-goblin-fight", "actorId": "act-cutter", "position": {"x": 1, "y": 0}}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"placeToken": {"tokenId": "tok-archer", "sceneId": "scn-goblin-fight", "actorId": "act-archer", "position": {"x": 5, "y": 0}}}, "expect": {"ok": true}},

    {"by": "fighter", "command": {"useAbility": {"actorId": "act-fighter", "abilityId": "longsword-strike", "targetIds": ["act-cutter"]}}, "expect": {"ok": true}},

    {"by": "fighter", "command": {"useAbility": {"actorId": "act-fighter", "abilityId": "staggering-blow", "targetIds": ["act-cutter"]}}, "expect": {"ok": true}},

    {"by": "dm", "command": {"useAbility": {"actorId": "act-archer", "abilityId": "goblin-shortbow", "targetIds": ["act-fighter"]}}, "expect": {"ok": true}},

    {"by": "fighter", "command": {"useAbility": {"actorId": "act-fighter", "abilityId": "rally", "targetIds": ["act-fighter"]}}, "expect": {"ok": true}},
    {"by": "fighter", "command": {"useAbility": {"actorId": "act-fighter", "abilityId": "rally", "targetIds": ["act-fighter"]}}, "expect": {"ok": true}},

    {"by": "fighter", "command": {"useAbility": {"actorId": "act-fighter", "abilityId": "hunters-flurry", "targetIds": ["act-cutter", "act-archer"]}}, "expect": {"ok": true}},
    {"by": "fighter", "command": {"useAbility": {"actorId": "act-fighter", "abilityId": "hunters-flurry", "targetIds": ["act-cutter", "act-archer"]}}, "expect": {"deniedContaining": "insufficient"}},

    {"by": "dm", "command": {"removeCondition": {"actorId": "act-archer", "conditionId": "dazed"}}, "expect": {"deniedContaining": "not present"}},

    {"by": "fighter", "command": {"useAbility": {"actorId": "act-cutter", "abilityId": "goblin-scimitar", "targetIds": ["act-fighter"]}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "spectator", "command": {"useAbility": {"actorId": "act-fighter", "abilityId": "longsword-strike", "targetIds": ["act-cutter"]}}, "expect": {"deniedContaining": "not authorized"}},

    {"by": "dm", "command": {"moveToken": {"tokenId": "tok-archer", "to": {"x": 30, "y": 0}}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"useAbility": {"actorId": "act-archer", "abilityId": "goblin-shortbow", "targetIds": ["act-fighter"]}}, "expect": {"deniedContaining": "out of range"}},

    {"by": "dm", "command": {"endSession": {}}, "expect": {"ok": true}}
  ],
  "probes": [
    {"actorExists": {"actorId": "act-fighter"}},
    {"actorExists": {"actorId": "act-cutter"}},
    {"actorExists": {"actorId": "act-archer"}},
    {"tokenAt": {"tokenId": "tok-fighter", "x": 0, "y": 0}},
    {"tokenAt": {"tokenId": "tok-cutter", "x": 1, "y": 0}},
    {"tokenAt": {"tokenId": "tok-archer", "x": 30, "y": 0}},
    {"sessionCount": {"open": 0, "total": 1}},
    {"resourceAt": {"actorId": "act-fighter", "resource": "hp", "value": 28}},
    {"resourceAt": {"actorId": "act-fighter", "resource": "flurry_uses", "value": 0}},
    {"hasCondition": {"actorId": "act-archer", "conditionId": "dazed", "present": false}}
  ]
}
