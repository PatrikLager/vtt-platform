{
  "name": "toy-brawl",
  "ruleset": "tavern-brawl",
  "maps": "scenarios/maps",
  "participants": [
    {"name": "dm", "role": "dm"},
    {"name": "brawler", "role": "spectator"},
    {"name": "patron", "role": "spectator"},
    {"name": "Kalle", "role": "spectator"}
  ],
  "steps": [
    {"by": "dm", "command": {"startSession": {"name": "Toy Brawl"}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"loadMap": {"mapId": "scn-tavern"}}, "expect": {"ok": true}},

    {"by": "dm", "command": {"addActor": {"actor": {
      "actorId": "act-brawler", "name": "Brawler", "kind": "ACTOR_KIND_PARTY_MEMBER",
      "attributes": {"brawn": 3, "grit": 1},
      "resources": {"drink": {"current": 0, "max": 4}, "stamina": {"current": 2, "max": 2}},
      "abilityIds": ["chair-swing", "fists", "sober-up", "splash-of-water"]
    }}}, "expect": {"ok": true}},

    {"by": "dm", "command": {"addActor": {"actor": {
      "actorId": "act-patron", "name": "Patron", "kind": "ACTOR_KIND_PARTY_MEMBER",
      "attributes": {"brawn": 1, "grit": 0, "footing": 0},
      "resources": {"drink": {"current": 0, "max": 3}, "stamina": {"current": 2, "max": 2}},
      "abilityIds": ["chair-swing", "fists", "sober-up", "splash-of-water"]
    }}}, "expect": {"ok": true}},

    {"by": "dm", "command": {"grantActorControl": {"actorId": "act-brawler", "participantId": "{{id:brawler}}", "kind": "ACTOR_KIND_PARTY_MEMBER"}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"grantActorControl": {"actorId": "act-patron", "participantId": "{{id:patron}}", "kind": "ACTOR_KIND_PARTY_MEMBER"}}, "expect": {"ok": true}},

    {"by": "dm", "command": {"placeToken": {"tokenId": "tok-brawler", "sceneId": "scn-tavern", "actorId": "act-brawler", "position": {"x": 0, "y": 0}}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"placeToken": {"tokenId": "tok-patron", "sceneId": "scn-tavern", "actorId": "act-patron", "position": {"x": 1, "y": 0}}}, "expect": {"ok": true}},

    {"by": "brawler", "command": {"useAbility": {"actorId": "act-brawler", "abilityId": "fists", "targetIds": ["act-patron"]}}, "expect": {"ok": true}},

    {"by": "patron", "command": {"useAbility": {"actorId": "act-brawler", "abilityId": "fists", "targetIds": ["act-patron"]}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "Kalle", "command": {"useAbility": {"actorId": "act-brawler", "abilityId": "fists", "targetIds": ["act-patron"]}}, "expect": {"deniedContaining": "not authorized"}},

    {"by": "dm", "command": {"removeCondition": {"actorId": "act-patron", "conditionId": "dazed-by-ale"}}, "expect": {"ok": true}},

    {"by": "patron", "command": {"removeCondition": {"actorId": "act-brawler", "conditionId": "dazed-by-ale"}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "Kalle", "command": {"removeCondition": {"actorId": "act-patron", "conditionId": "dazed-by-ale"}}, "expect": {"deniedContaining": "not authorized"}},

    {"by": "dm", "command": {"takeAbility": {"actorId": "act-patron", "abilityId": "sober-up"}}, "expect": {"ok": true}},

    {"by": "patron", "command": {"giveAbility": {"actorId": "act-patron", "abilityId": "sober-up"}}, "expect": {"deniedContaining": "not authorized"}},
    {"by": "Kalle", "command": {"takeAbility": {"actorId": "act-patron", "abilityId": "fists"}}, "expect": {"deniedContaining": "not authorized"}},

    {"by": "dm", "command": {"giveAbility": {"actorId": "act-patron", "abilityId": "no-such-move"}}, "expect": {"deniedContaining": "names ability \"no-such-move\", which the ruleset does not hold"}},
    {"by": "dm", "command": {"takeAbility": {"actorId": "act-patron", "abilityId": "sober-up"}}, "expect": {"deniedContaining": "does not name ability \"sober-up\""}},

    {"by": "dm", "command": {"giveAbility": {"actorId": "act-patron", "abilityId": "sober-up"}}, "expect": {"ok": true}},

    {"by": "dm", "command": {"takeAbility": {"actorId": "act-patron", "abilityId": "chair-swing"}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"giveAbility": {"actorId": "act-patron", "abilityId": "chair-swing"}}, "expect": {"deniedContaining": "ability \"chair-swing\" spends resource \"stamina\", which the sheet does not hold"}},
    {"by": "dm", "command": {"giveAbility": {"actorId": "act-patron", "abilityId": "chair-swing", "resources": {"stamina": {"current": 1, "max": 3}}}}, "expect": {"ok": true}},
    {"by": "dm", "command": {"giveAbility": {"actorId": "act-patron", "abilityId": "chair-swing", "resources": {"stamina": {"current": 2, "max": 2}}}}, "expect": {"deniedContaining": "the sheet holds resource \"stamina\" already"}},

    {"by": "dm", "command": {"endSession": {}}, "expect": {"ok": true}}
  ],
  "probes": [
    {"actorExists": {"actorId": "act-brawler"}},
    {"actorExists": {"actorId": "act-patron"}},
    {"tokenAt": {"tokenId": "tok-brawler", "x": 0, "y": 0}},
    {"tokenAt": {"tokenId": "tok-patron", "x": 1, "y": 0}},
    {"sessionCount": {"open": 0, "total": 1}},
    {"resourceAt": {"actorId": "act-patron", "resource": "drink", "value": 1}},
    {"hasCondition": {"actorId": "act-patron", "conditionId": "dazed-by-ale", "present": false}},
    {"resourceAt": {"actorId": "act-patron", "resource": "stamina", "value": 1}}
  ]
}
