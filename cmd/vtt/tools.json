[
  {
    "description": "Move a token to a new grid position on its scene.",
    "inputSchema": {
      "properties": {
        "reason": {
          "type": "string"
        },
        "to": {
          "properties": {
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "type": "object"
        },
        "tokenId": {
          "type": "string"
        }
      },
      "required": [
        "tokenId",
        "to"
      ],
      "type": "object"
    },
    "name": "move_token"
  },
  {
    "description": "Create a new scene with a grid.",
    "inputSchema": {
      "properties": {
        "gridHeight": {
          "type": "integer"
        },
        "gridWidth": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "sceneId": {
          "type": "string"
        }
      },
      "required": [
        "sceneId",
        "name",
        "gridWidth",
        "gridHeight"
      ],
      "type": "object"
    },
    "name": "create_scene"
  },
  {
    "description": "Add an actor to the campaign.",
    "inputSchema": {
      "properties": {
        "actor": {
          "properties": {
            "actorId": {
              "type": "string"
            },
            "attributes": {
              "additionalProperties": {
                "type": "integer"
              },
              "description": "Optional; omit unless a rule module instructs otherwise — moduleData is opaque.",
              "type": "object"
            },
            "controllerId": {
              "description": "Omit or empty = DM/agent-controlled; set a participant id to hand control to a player.",
              "type": "string"
            },
            "moduleData": {
              "description": "Optional; omit unless a rule module instructs otherwise — moduleData is opaque.",
              "type": "object"
            },
            "moduleId": {
              "description": "Optional; omit unless a rule module instructs otherwise — moduleData is opaque.",
              "type": "string"
            },
            "name": {
              "description": "Optional display label for the actor.",
              "type": "string"
            },
            "resources": {
              "additionalProperties": {
                "properties": {
                  "current": {
                    "type": "integer"
                  },
                  "max": {
                    "type": "integer"
                  }
                },
                "required": [
                  "current",
                  "max"
                ],
                "type": "object"
              },
              "description": "Optional; omit unless a rule module instructs otherwise — moduleData is opaque.",
              "type": "object"
            }
          },
          "required": [
            "actorId"
          ],
          "type": "object"
        }
      },
      "required": [
        "actor"
      ],
      "type": "object"
    },
    "name": "add_actor"
  },
  {
    "description": "Place an actor's token on a scene's grid.",
    "inputSchema": {
      "properties": {
        "actorId": {
          "type": "string"
        },
        "position": {
          "properties": {
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "type": "object"
        },
        "sceneId": {
          "type": "string"
        },
        "tokenId": {
          "type": "string"
        }
      },
      "required": [
        "tokenId",
        "sceneId",
        "actorId",
        "position"
      ],
      "type": "object"
    },
    "name": "place_token"
  },
  {
    "description": "Start a new play session.",
    "inputSchema": {
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "name": "start_session"
  },
  {
    "description": "End the current play session.",
    "inputSchema": {
      "properties": {},
      "required": [],
      "type": "object"
    },
    "name": "end_session"
  },
  {
    "description": "Retract a range of events from the record with a stated reason.",
    "inputSchema": {
      "properties": {
        "fromSequence": {
          "type": "integer"
        },
        "reason": {
          "type": "string"
        },
        "toSequence": {
          "type": "integer"
        }
      },
      "required": [
        "fromSequence",
        "toSequence",
        "reason"
      ],
      "type": "object"
    },
    "name": "retract_events"
  },
  {
    "description": "Use one of the loaded ruleset's abilities as an actor against explicit targets.",
    "inputSchema": {
      "properties": {
        "abilityId": {
          "type": "string"
        },
        "actorId": {
          "type": "string"
        },
        "targetIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "actorId",
        "abilityId",
        "targetIds"
      ],
      "type": "object"
    },
    "name": "use_ability"
  },
  {
    "description": "Remove a named condition from an actor (DM-ended durations).",
    "inputSchema": {
      "properties": {
        "actorId": {
          "type": "string"
        },
        "conditionId": {
          "type": "string"
        }
      },
      "required": [
        "actorId",
        "conditionId"
      ],
      "type": "object"
    },
    "name": "remove_condition"
  },
  {
    "description": "Add a story entry to the table's shared narrative — narration, in-character speech (set `as`), or table talk; optionally anchored to the event sequences it narrates.",
    "inputSchema": {
      "properties": {
        "anchorFromSeq": {
          "type": "integer"
        },
        "anchorToSeq": {
          "type": "integer"
        },
        "as": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "as",
        "anchorFromSeq",
        "anchorToSeq"
      ],
      "type": "object"
    },
    "name": "add_narration"
  },
  {
    "description": "Create or replace a keyed world note (locations, NPCs, quest state) — the campaign's durable memory.",
    "inputSchema": {
      "properties": {
        "key": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "title",
        "text"
      ],
      "type": "object"
    },
    "name": "upsert_note"
  },
  {
    "description": "Delete a world note by key.",
    "inputSchema": {
      "properties": {
        "key": {
          "type": "string"
        }
      },
      "required": [
        "key"
      ],
      "type": "object"
    },
    "name": "delete_note"
  }
]
