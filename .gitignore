node_modules/
coverage/
*.out
.DS_Store

# vtt client run/soak --tokens files hold plaintext bearer credentials —
# never commit these (see README.md's harness section).
tokens.json
*.tokens.json

# Claude Code's MCP server config, local to whoever sets up `vtt mcp` (see
# README.md's "Claude Code: seating an LLM as the agent participant") —
# the README's snippet carries no token value by design (env passthrough),
# but a local .mcp.json is still a personal machine-specific file, not
# something this repo should track.
.mcp.json
client/e2e/.artifacts/
client/e2e/.report/
.tscov/
.stryker-tmp/
reports/

# The CLI binary. `go build ./...` drops it in the repo root for any main
# package -- `task build` and `go test` do not, so it only appears for whoever
# runs that at the root, and no hook would stop a `git add -A` committing 26 MB.
/vtt
