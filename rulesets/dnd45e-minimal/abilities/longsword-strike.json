{
  "id": "longsword-strike",
  "name": "Longsword Strike",
  "usage": "at_will",
  "compose": [
    { "atom": "melee-delivery", "bind": { "reach": 1 } },
    { "atom": "weapon-attack-roll", "bind": { "attack_stat": "str", "prof": 3, "defense": "ac" } },
    { "atom": "weapon-damage", "bind": { "damage_expr": "1d8 + @caster.str" } }
  ]
}
