    [
      {
        "kind": "resource_change",
        "resource": "hp",
        "delta_expr": "0 - (1d8 + @caster.dex)"
      }
    ],
    [
      {
        "kind": "resource_change",
        "resource": "hp",
        "delta_expr": "0 - half((1d8 + @caster.dex))"
      }
    ]
  ]
