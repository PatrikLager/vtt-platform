{
  "id": "hunters-flurry",
  "name": "Hunter's Flurry",
  "usage": {
    "limited": {
      "resource": "flurry_uses",
      "cost": 1
    }
  },
  "targeting": {
    "range": 10,
    "max_targets": 2
  },
  "resolution": {
    "roll": "1d20 + @caster.dex + (2)",
